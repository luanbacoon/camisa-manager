# =============================================================================
# BANCO DE DADOS
# =============================================================================
# URL de conexão com o MySQL
# Formato: mysql://usuario:senha@host:porta/nome_do_banco
DATABASE_URL=mysql://root:senha@localhost:3306/camisa_manager

# =============================================================================
# AUTENTICAÇÃO
# =============================================================================
# Segredo para assinar os tokens JWT de sessão
# Gere um valor seguro com: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=troque_por_um_segredo_longo_e_aleatorio_aqui

# OpenID do usuário dono da loja (usado para dar permissão de admin automaticamente)
OWNER_OPEN_ID=seu_open_id_aqui

# =============================================================================
# OAUTH (Login)
# =============================================================================
# ID da aplicação no portal OAuth
VITE_APP_ID=seu_app_id_aqui

# URL do servidor OAuth (backend)
OAUTH_SERVER_URL=https://seu-oauth-server.com

# URL do portal OAuth (frontend, acessível pelo browser)
VITE_OAUTH_PORTAL_URL=https://seu-oauth-portal.com

# =============================================================================
# AWS S3 (Upload de Imagens)
# =============================================================================
# Necessário apenas se quiser fazer upload de imagens de produtos
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=sua_access_key_aqui
AWS_SECRET_ACCESS_KEY=sua_secret_key_aqui
AWS_S3_BUCKET=nome-do-seu-bucket

# =============================================================================
# SERVIDOR
# =============================================================================
# Porta em que o servidor vai rodar (padrão: 3000)
PORT=3000

# Ambiente de execução: development | production
NODE_ENV=development
